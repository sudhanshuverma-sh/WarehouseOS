# Copy to .env.local (gitignored) for local development.
#
# In production on apps.blinkit.in these are set in the platform's config,
# never in a file. DATABASE_URL is injected for you when you add Postgres
# to the project — you do not create it, copy it, or paste it anywhere.
#
# NOTHING SECRET GETS A VITE_ PREFIX. Anything prefixed VITE_ is compiled
# into the JS bundle and readable by every visitor. The database URL, and
# any token or password, belong to the server side only.

# ---------------------------------------------------------------------
# Database — server side only
# ---------------------------------------------------------------------
DATABASE_URL=postgres://wos_app:local-dev-password@localhost:5432/warehouseos
DB_POOL_MAX=10
DB_SSL=false

# ---------------------------------------------------------------------
# Who is making the request
#
#   header  a trusted proxy sets AUTH_HEADER_NAME. ONLY safe when this
#           service cannot be reached except through that proxy — if
#           anything on the network can hit it directly, it can set the
#           header itself and become the SUPER_ADMIN.
#   jwt     a signed token, verified against AUTH_JWKS_URL. Safe
#           regardless of ingress.
#   dev     everyone is DEV_ACTOR_EMAIL. Refuses to start when
#           NODE_ENV=production.
#
# Ask the platform which of these it provides, and under what name:
#   "When a signed-in user opens my app, what identity does my service
#    receive — a header, a JWT? What is it called exactly?"
# ---------------------------------------------------------------------
AUTH_MODE=dev
DEV_ACTOR_EMAIL=sudhanshu.verma@grofers.com

# AUTH_MODE=header
# AUTH_HEADER_NAME=x-auth-request-email

# AUTH_MODE=jwt
# AUTH_JWKS_URL=
# AUTH_JWT_CLAIM=email

# ---------------------------------------------------------------------
# Bootstrap
#
# RLS lets only a SUPER_ADMIN write master data. If the seed contains no
# active SUPER_ADMIN row, nobody can administer the app and there is no
# way back in through the UI. Two or three addresses, not one.
# ---------------------------------------------------------------------
SUPER_ADMIN_EMAILS=sudhanshu.verma@grofers.com

PORT=8080
