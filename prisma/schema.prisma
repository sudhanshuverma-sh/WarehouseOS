// Prisma is here for ONE reason: Prisma Studio, a browser for the
// database while building. Nothing in src/ or server/ imports Prisma, and
// nothing should — the app talks to Postgres through server/db.ts, which
// sets app.actor_email per transaction so Row Level Security can do its
// job. An ORM that does not know about that would quietly bypass it.
//
// So treat this file as a dev tool's config, not as the schema. The real
// schema is db/schema.sql and db/ebdg.sql. Those own the triggers, the
// CHECK constraints, the RLS policies and the functions, none of which
// Prisma's schema language can express.
//
// The models below are written by `prisma db pull`, which reads whatever
// is actually in the database. Never hand-edit them, and never run
// `prisma migrate` against this project — it would try to reshape the
// database to match this file and drop everything it cannot see.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
